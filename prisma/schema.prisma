generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["portal", "hr", "public"]
}

// 구독 테이블 (portal 스키마 — 포털 소유)
model PushSubscription {
  id         Int       @id @default(autoincrement())
  employeeId Int       @map("employee_id")
  endpoint   String    @unique
  p256dhKey  String    @map("p256dh_key")
  authKey    String    @map("auth_key")
  userAgent  String?   @map("user_agent")
  isActive   Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([employeeId, isActive], map: "idx_portal_push_subs_emp")
  @@map("push_subscriptions")
  @@schema("portal")
}

// 런처 메뉴 사용 기록 (portal 스키마 — 사용자 × 메뉴키 × KST 날짜, 테이블은 prisma/sql/2026-10-02_launcher.sql)
model LauncherUsageDaily {
  userEmail  String   @map("user_email") @db.VarChar(255)
  menuKey    String   @map("menu_key") @db.VarChar(100)
  usedOn     DateTime @map("used_on") @db.Date
  cnt        Int      @default(0)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(6)

  @@id([userEmail, menuKey, usedOn])
  @@index([userEmail, usedOn], map: "idx_launcher_usage_daily_user_date")
  @@map("launcher_usage_daily")
  @@schema("portal")
}

// 런처 사용자별 배치 (즐겨찾기·숨김·앱 순서)
model LauncherPrefs {
  userEmail String   @id @map("user_email") @db.VarChar(255)
  pinned    Json     @default("[]")
  hidden    Json     @default("[]")
  appOrder  Json     @default("[]") @map("app_order")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("launcher_prefs")
  @@schema("portal")
}

// hr.employees 읽기 전용 매핑 (email → employeeId 해석용, 필요 필드만)
model Employee {
  id    Int    @id
  email String @unique

  @@map("employees")
  @@schema("hr")
}

// public."user" 읽기 전용 매핑 (재고관리 앱 소유 — 로그인 허용 판정용, 필요 필드만)
// 이 테이블은 포털에서 migrate / db push 하지 않는다.
model AppUser {
  id       Int     @id
  email    String? @unique
  name     String
  isActive String  @map("is_active")

  @@map("user")
  @@schema("public")
}
