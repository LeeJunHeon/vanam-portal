# 로그인 (NextAuth · Google OAuth)
NEXTAUTH_URL=https://vanam.synology.me
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 포털 DB (portal·hr 스키마, 로그인 확인용 public."user" 읽기)
DATABASE_URL=

# 웹 푸시 (VAPID 키) · 다른 앱이 /api/internal/push 를 부를 때 쓰는 토큰
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_INTERNAL_TOKEN=

# 챗봇 LLM 게이트웨이
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=

# 재고앱 내부 API (챗 스키마 조회·입출고 쓰기 프록시)
INVENTORY_API_URL=http://inventory-web-nextjs:3000
INVENTORY_WRITE_TOKEN=
MCP_API_TOKEN=

# 장비앱 내부 API (챗 스키마 조회·장비 쓰기 프록시)
EQUIPMENT_API_URL=
EQUIP_WRITE_TOKEN=
EQUIP_MCP_TOKEN=

# 인사앱 내부 API (챗 스키마 조회·근태 조회·신청 프록시)
HR_API_URL=
HR_PORTAL_TOKEN=
HR_WRITE_TOKEN=

# 실시간 통역(jensen Mac mini) 상태 확인 주소 — 비우면 기본값 http://192.168.0.83:8790/translator/healthz
TRANSLATOR_HEALTH_URL=

# 업무 비서(ai-assistant-web, vanam-db-net) 상태 확인 주소 — 비우면 기본값 http://ai-assistant-web:8000/assistant/healthz
ASSISTANT_HEALTH_URL=

# HTTPS 인증서 확인 대상(쉼표 구분, 앞에서부터 시도) — 비우면 기본값 vanam.synology.me,192.168.0.210
CERT_CHECK_HOSTS=
# 인증서 확인 시 보낼 SNI 이름 — 비우면 기본값 vanam.synology.me
CERT_CHECK_SERVERNAME=

# 로그인 허용 이메일 도메인(쉼표 구분, 예: vanam.co.kr) — 비우면 도메인 제한 없음
ALLOWED_EMAIL_DOMAINS=
