# Docker 빌드 컨텍스트에서 제외 (Dockerfile 의 COPY . . 로 이미지에 들어가지 않게)

# 비밀값 — 런타임 값은 docker-compose.yml 의 environment 로만 넘긴다
# (.env 가 들어가면 next build 가 .next/standalone 에 복사해 실행 이미지에 남는다)
.env
.env.*

# 의존성·빌드 산출물 — 이미지 안에서 새로 만든다
node_modules
.next
out
build
coverage
.git
*.log

# 편집기·OS 파일
.DS_Store
.vscode
.idea

# 문서·배포 파일 (빌드·실행에 쓰지 않음)
*.md
docker-compose.yml
deploy.sh
Dockerfile
